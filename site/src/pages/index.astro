---
import Site from '../layouts/Site.astro';
const clients = [
  { name: 'npm', command: 'npm install --registry https://packages.example.com/npm lodash', note: 'Use the npm client you already know. Point its registry at your Bodega server.', id: 'npm' },
  { name: 'pip', command: 'pip install --index-url https://packages.example.com/pypi/simple/ examplesdk', note: 'Serve Python packages through the standard simple index.', id: 'pypi' },
  { name: 'Go', command: 'GOPROXY=https://packages.example.com/go go get example.com/team/sdk@v1.30.0', note: 'Use the native Go module proxy protocol.', id: 'gomod' },
  { name: 'Helm', command: 'helm repo add bodega https://packages.example.com/helm', note: 'Add your Bodega server as a chart repository.', id: 'helm' },
];
---
<Site title="Bodega — Your packages. Your network.">
  <section class="hero shell">
    <div class="hero-copy">
      <p class="intro-line"><span class="square-dot" aria-hidden="true"></span>A self-hosted package repository</p>
      <h1>Your packages.<br />Your network.</h1>
      <p class="hero-description">Keep the clients. Take control of what they install.</p>
      <p class="hero-detail">Bodega mirrors, builds, and serves packages from one place on your network. Set the policy. Keep the artifacts. Know who fetched what.</p>
      <div class="actions"><a class="button primary" href="/docs/quickstart/">Set up Bodega <span aria-hidden="true">↗</span></a><a class="text-link" href="/coverage/">Explore package support</a></div>
      <p class="hero-footnote">One Go binary. Linux &amp; FreeBSD. Apache 2.0.</p>
    </div>
    <div class="depot-scene" aria-label="Bodega: a local depot for your packages">
      <div class="depot-disc"></div>
      <span class="route-label route-top">Upstream registries</span><span class="route-line line-top" aria-hidden="true"></span>
      <img class="depot-image" src="/assets/depot.png" width="512" height="512" alt="A pixel-art Bodega depot with a parcel ready at the door" fetchpriority="high" />
      <span class="route-line line-bottom" aria-hidden="true"></span><span class="route-label route-bottom">The hosts you run</span>
      <span class="parcel-label">Received. Checked. Served.</span>
    </div>
  </section>

  <section class="client-band" aria-labelledby="client-title">
    <div class="shell client-layout"><div><h2 id="client-title">Same clients.<br />A different source.</h2><p>No new install ritual.</p></div>
      <div class="client-demo">
        <div class="client-tabs" role="group" aria-label="Choose a package client">{clients.map((client, index) => <button type="button" data-client={index} aria-pressed={index === 0}>{client.name}</button>)}</div>
        <div class="command-line"><span aria-hidden="true">$</span><code id="client-command">{clients[0].command}</code><button id="copy-command" type="button" aria-label="Copy example command">Copy</button></div>
        <p id="client-note">{clients[0].note}</p>
        <a id="client-support" href="/coverage/?manager=npm">Check npm support <span aria-hidden="true">↗</span></a>
        <p class="example-note">Example address and packages. Use your own repository hostname.</p>
      </div>
    </div>
  </section>

  <section class="section shell product-section" aria-labelledby="product-title">
    <div class="section-heading"><div><p class="section-kicker">A repository you can inspect</p><h2 id="product-title">See what’s on the shelf.</h2></div><p>Packages, versions, checksums, and client configuration. The shell puts the details in reach.</p></div>
    <div class="product-frame"><div class="frame-bar"><span><span class="status-dot"></span> bodega shell</span><span>Manifest → artifact → client</span></div><img src="/assets/tui-main-view.png" width="1600" height="900" loading="lazy" alt="Bodega shell showing an npm package, its pinned version, verified checksum, and client registry configuration" /></div>
    <div class="product-caption"><span>The actual Bodega TUI.</span><a href="/docs/operator/tui/">Explore the shell</a></div>
  </section>

  <section class="section shell workflow-section" aria-labelledby="workflow-title">
    <div class="section-heading"><div><p class="section-kicker">From upstream to your hosts</p><h2 id="workflow-title">You decide what gets through.</h2></div><a class="text-link" href="/docs/operator/supply-chain-management/">Read the policy guide</a></div>
    <div class="workflow">
      <article><span class="step-number">1</span><h3>Bring packages in.</h3><p>Mirror upstream registries or host what you build. Keep artifacts on local disk, in S3, or across named storage backends.</p><a href="/docs/operator/proxycache/">Mirroring &amp; caching</a></article>
      <article><span class="step-number">2</span><h3>Apply your rules.</h3><p>Control sources and versions. Use release-age checks, vulnerability data, and host profiles where the package type supports them.</p><a href="/coverage/">Compare policy coverage</a></article>
      <article><span class="step-number">3</span><h3>Serve. Then account for it.</h3><p>Deliver packages through native protocols. Trace requests and refusals, and reconcile installed software with what Bodega served.</p><a href="/docs/operator/audit-trail/">Follow the audit trail</a></article>
    </div>
  </section>

  <section class="shell slsa-note" aria-labelledby="slsa-title">
    <div>
      <h2 id="slsa-title">Supply chain controls, with their limits stated.</h2>
      <p>bodega targets Level 2 of the draft SLSA Dependency track, with stated gaps.
        Host inventory reconciliation detects bypass; it does not provide Level 3
        prevention. The build track for bodega's own releases is assessed separately.</p>
    </div>
    <a class="text-link" href="/docs/slsa/">Read the SLSA assessment</a>
  </section>

  <section class="coverage-teaser"><div class="shell teaser-layout"><div><p class="section-kicker">Evidence, included</p><h2>“Supported” deserves<br />a little more detail.</h2><p>See which features exist, which real-client tests passed, and where the gaps remain. Every result names the build it evaluated.</p><a class="button primary" href="/coverage/">Open the coverage explorer <span aria-hidden="true">↗</span></a></div><div class="evidence-preview" aria-label="What the coverage explorer shows"><div><span>Package manager</span><strong>Feature-by-feature support</strong></div><div><span>Readiness</span><strong>Ready · Usable · Partial</strong></div><div><span>Real-client tests</span><strong>Results by host group</strong></div><div><span>Evidence</span><strong>Revision, date, and known gaps</strong></div><p>Feature coverage and test results stay separate.<br />No mystery green checkmark.</p></div></div></section>

  <section class="section shell closing"><div><p class="section-kicker">Built for operators</p><h2>Start small.<br />Keep control.</h2><p>Bring up a server, add a package, and point a client at it. The operator docs cover what comes next.</p></div><div class="docs-links"><a href="/docs/quickstart/"><span>Start a repository</span><span>Installation &amp; first fetch ↗</span></a><a href="/docs/"><span>Run it day to day</span><span>Configuration, policy &amp; recovery ↗</span></a><a href="/docs/threat-model/"><span>Know the boundaries</span><span>Threat model &amp; limitations ↗</span></a></div></section>
</Site>
<script define:vars={{ clients }}>
  const command = document.querySelector('#client-command');
  const copy = document.querySelector('#copy-command');
  document.querySelectorAll('[data-client]').forEach(button => button.addEventListener('click', () => {
    const client = clients[Number(button.dataset.client)];
    document.querySelectorAll('[data-client]').forEach(tab => tab.setAttribute('aria-pressed', String(tab === button)));
    command.textContent = client.command;
    document.querySelector('#client-note').textContent = client.note;
    const support = document.querySelector('#client-support');
    support.textContent = `Check ${client.name} support ↗`;
    support.href = `/coverage/?manager=${client.id}`;
    copy.textContent = 'Copy';
  }));
  copy.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(command.textContent); copy.textContent = 'Copied'; }
    catch { copy.textContent = 'Select to copy'; }
  });
</script>
