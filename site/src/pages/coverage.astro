---
import Site from '../layouts/Site.astro';
import PackageRow from '../layouts/PackageRow.astro';
import snapshot from '../../public/data/coverage.json';
import type { CoverageReport } from '../coverage';
const report: CoverageReport = snapshot;
const ready = report.packages.filter(p => p.verdict === 'Ready').length;
const usable = report.packages.filter(p => p.verdict === 'Usable').length;
---
<Site title="Package support & test evidence — Bodega" description="Inspect Bodega package support, feature coverage, readiness, and real-client test evidence by package manager.">
  <div class="shell page-intro"><p class="section-kicker">Package support</p><h1>Know what you can rely on.</h1><p class="lead">The features, the tests, and the gaps. Choose a package manager to see what Bodega supports and the evidence behind its readiness.</p></div>
  <section class="shell coverage-section" aria-label="Package coverage explorer">
    <div class="readiness-summary"><div><strong id="ready-count">{ready}</strong><span>Ready</span></div><div><strong id="usable-count">{usable}</strong><span>Usable with limits</span></div><div><strong id="remaining-count">{report.packages.length - ready - usable}</strong><span>Needs a closer look</span></div></div>
    <p class="report-meta">Evaluated <time id="report-date" datetime={report.evaluatedAt}>{report.evaluatedAt.replace('T', ' ').replace(':00Z', ' UTC')}</time> · build <a id="report-revision-link" href={`https://github.com/ravinald/bodega/commit/${report.revision}`}><code id="report-revision">{report.revision}</code></a>. <a href="#methodology">How to read these results</a></p>
    <p class="freshness-warning" id="freshness-warning" hidden></p>
    <form class="coverage-controls" id="coverage-controls" role="search" aria-label="Filter package support">
      <label>Find a package manager<input id="manager-query" type="search" placeholder="Try npm, Python, or FreeBSD" autocomplete="off" /></label>
      <label>Readiness<select id="readiness-filter"><option value="">All states</option><option>Ready</option><option>Usable</option><option>Partial</option><option>Unverified</option><option>Not yet</option><option>Not served</option></select></label>
      <label>Feature present<select id="feature-filter"><option value="">All features</option>{report.packages[0].features.map(feature => <option>{feature.label}</option>)}</select></label>
      <button type="reset">Reset</button>
    </form>
    <p class="result-count" id="result-count" role="status" aria-live="polite">{report.packages.length} package types · Expand a row for evidence.</p>
    <div class="column-labels" aria-hidden="true"><span>Package manager</span><span>Readiness</span><span>Feature coverage</span><span></span></div>
    <div class="package-list" id="package-list">{report.packages.map(pkg => <PackageRow pkg={pkg} />)}</div>
    <p id="no-results" hidden>No package types match these filters. Try a different feature or reset the filters.</p>
    <noscript><p>All package types and their evidence are available above. Enable JavaScript for filters and the newest published snapshot.</p></noscript>
  </section>
  <section class="methodology" id="methodology"><div class="shell"><h2>Read the evidence, not just the color.</h2><div class="methodology-grid"><div><h3>Readiness is an operational judgment.</h3><p>Ready means current primary suites pass on at least two host groups and feature coverage reaches 80%. Usable means the evaluated evidence supports use with stated limits. Expand the row for the exact reason and any recorded override.</p><p>Partial indicates failing primary checks or a partial high-weight feature. Not yet means a high-weight feature is missing or more than 10% of current primary checks fail. Unverified means there is no current primary test run; Not served means the type is not served in the evaluated report.</p></div><div><h3>Feature coverage is not code coverage.</h3><p>The percentage measures applicable features, weighted by their importance. Partial support counts half; not-applicable features leave the denominator. Missing or stale evidence is shown explicitly.</p><p>Proxy, allow-list, and client setup weigh 3; discovery, profiles, release age, and OSV weigh 2; typosquat checks, attestation, and hosted packages weigh 1.</p></div><div><h3>Test results keep their context.</h3><p>Runs show passed/total checks by host group. Skips, expected failures, and unexpected passes remain visible. Shared suites can appear under multiple package types: adding row totals would double-count them.</p><p>The report counts runs while under 48 hours old and at most 15 commits behind the evaluated build. Stale runs remain visible as history.</p></div><div><h3>A snapshot, with its age attached.</h3><p>These results come from Bodega’s evaluated package report. The public feed checks for updates every five minutes while the reporting workstation is running. Its evaluation time is separate from the website’s deployment time.</p><p>Bodega is pre-1.0. Use this evidence alongside the <a href="/docs/threat-model/">threat model</a> and your own workload validation. <a href="/data/coverage.json">Download the evidence JSON</a>.</p></div></div></div></section>
</Site>
<script>
  import { labels, createPackageRow, type CoverageReport } from '../coverage';
  const form = document.querySelector<HTMLFormElement>('#coverage-controls')!;
  const query = document.querySelector<HTMLInputElement>('#manager-query')!;
  const readiness = document.querySelector<HTMLSelectElement>('#readiness-filter')!;
  const feature = document.querySelector<HTMLSelectElement>('#feature-filter')!;
  const list = document.querySelector<HTMLElement>('#package-list')!;
  const warning = document.querySelector<HTMLElement>('#freshness-warning')!;
  let report: CoverageReport | undefined;
  const requested = new URLSearchParams(location.search).get('manager');
  if (requested) query.value = requested;
  function filterRows() {
    let count = 0;
    for (const row of list.querySelectorAll<HTMLDetailsElement>('.package-row')) {
      const id = row.dataset.manager!;
      const search = [id, ...(labels[id] || [])].join(' ').toLowerCase();
      const pkg = report?.packages.find(p => p.id === id);
      const hasFeature = !feature.value || (pkg ? pkg.features.some(f => f.label === feature.value && f.value === 'yes') : Array.from(row.querySelectorAll('.feature-entry')).some(entry => entry.querySelector('summary span')?.textContent === feature.value && entry.querySelector('summary strong')?.textContent === 'yes'));
      row.hidden = !search.includes(query.value.toLowerCase().trim()) || Boolean(readiness.value && row.dataset.verdict !== readiness.value) || !hasFeature;
      if (!row.hidden) count++;
      if (requested === id && query.value === requested) row.open = true;
    }
    document.querySelector('#result-count')!.textContent = `${count} package ${count === 1 ? 'type' : 'types'} · Expand a row for evidence.`;
    (document.querySelector('#no-results') as HTMLElement).hidden = count !== 0;
  }
  function checkAge(date: string) {
    const hours = (Date.now() - Date.parse(date)) / 3600000;
    if (hours > 48) { warning.hidden = false; warning.textContent = 'This snapshot is more than 48 hours old. Readiness describes the evaluated build at that time; check individual run dates before relying on it.'; }
  }
  form.addEventListener('submit', e => e.preventDefault());
  form.addEventListener('input', filterRows);
  form.addEventListener('reset', () => { history.replaceState(null, '', '/coverage/'); setTimeout(filterRows, 0); });
  filterRows();
  checkAge(document.querySelector('time')!.dateTime);
  try {
    const response = await fetch('/data/coverage.json', { cache: 'no-cache' });
    if (!response.ok) throw new Error('Feed unavailable');
    const data: CoverageReport = await response.json();
    if (data.schemaVersion !== 1 || !Array.isArray(data.packages) || !data.packages.length || !Number.isFinite(Date.parse(data.evaluatedAt))) throw new Error('Invalid feed');
    const newRows = data.packages.map(createPackageRow);
    report = data; list.replaceChildren(...newRows);
    const ready = data.packages.filter(p => p.verdict === 'Ready').length;
    const usable = data.packages.filter(p => p.verdict === 'Usable').length;
    document.querySelector('#ready-count')!.textContent = String(ready);
    document.querySelector('#usable-count')!.textContent = String(usable);
    document.querySelector('#remaining-count')!.textContent = String(data.packages.length - ready - usable);
    const date = document.querySelector<HTMLTimeElement>('#report-date')!;
    date.dateTime = data.evaluatedAt; date.textContent = data.evaluatedAt.replace('T', ' ').replace(':00Z', ' UTC');
    document.querySelector('#report-revision')!.textContent = data.revision;
    document.querySelector<HTMLAnchorElement>('#report-revision-link')!.href = `https://github.com/ravinald/bodega/commit/${encodeURIComponent(data.revision)}`;
    warning.hidden = true; checkAge(data.evaluatedAt); filterRows();
  } catch {
    warning.hidden = false; warning.textContent = 'The current coverage feed could not be loaded. Showing the snapshot bundled with this website; its evaluation date is shown above.';
  }
</script>
