---
import Site from '../../layouts/Site.astro';
const groups = [
  { title: 'Install & deploy', detail: 'Bring up a repository and connect the first host.', links: [['Quick start', '/docs/quickstart/'], ['Supported platforms', '/docs/operator/platforms/'], ['Configuration & S3 setup', '/docs/operator/configuration/'], ['Run under systemd', '/docs/operator/running-under-systemd/'], ['Run under FreeBSD rc.d', '/docs/operator/running-under-rcd/'], ['HTTP server & client setup', '/docs/operator/http-server/']] },
  { title: 'Packages & storage', detail: 'Declare what you serve and where the artifacts live.', links: [['Manifest structure', '/docs/operator/manifest-structure/'], ['Build pipeline', '/docs/operator/pipeline/'], ['Proxy & cache', '/docs/operator/proxycache/'], ['Storage layout', '/docs/operator/storage-layout/'], ['Checksums', '/docs/operator/checksum-verification/'], ['Manifest integrity & repair', '/docs/operator/manifest-integrity/']] },
  { title: 'Policy & identity', detail: 'Control access, evaluate packages, and record exceptions.', links: [['Authentication & scopes', '/docs/operator/authentication/'], ['Supply chain policy', '/docs/operator/supply-chain-management/'], ['Attestations', '/docs/operator/attestations/'], ['External integrations', '/docs/operator/integrations/'], ['Threat model', '/docs/threat-model/'], ['SLSA tracks and gaps', '/docs/slsa/'], ['Release verification & reporting vulnerabilities', '/docs/security/']] },
  { title: 'Operate & investigate', detail: 'Inspect activity, resolve incidents, and recover service.', links: [['Audit trail', '/docs/operator/audit-trail/'], ['Host inventory', '/docs/operator/inventory/'], ['Interactive shell', '/docs/operator/tui/'], ['Web dashboard', '/docs/operator/web-dashboard/'], ['Quarantine a compromised release', '/docs/quarantine/'], ['Operations runbook', '/docs/runbook/']] },
  { title: 'Reference', detail: 'The exact commands, flags, and API behavior.', links: [['Command reference', '/docs/operator/commands/'], ['Global flags', '/docs/operator/global-flags/'], ['REST API', '/docs/operator/rest-api/'], ['Full operations reference', '/docs/usage/'], ['Package support & test evidence', '/coverage/']] },
  { title: 'Understand & contribute', detail: 'Architecture, implementation boundaries, and development.', links: [['Architecture', '/docs/design/'], ['Contributing', '/docs/contributing/'], ['Development reference', '/docs/operator/development/'], ['Source code', 'https://github.com/ravinald/bodega'], ['Release history', 'https://github.com/ravinald/bodega/releases']] },
];
---
<Site title="Operator documentation — Bodega" description="Install, configure, secure, monitor, and recover a Bodega package repository. Operator guides, command reference, and API documentation.">
  <div class="shell page-intro"><p class="section-kicker">Operator documentation</p><h1>From first fetch<br />to daily operations.</h1><p class="lead">Deploy the server, connect your clients, define the rules, and investigate what happens next.</p></div>
  <div class="shell"><div class="hub-callout"><p><strong>New to Bodega?</strong><br />Start with one package and one client. Expand from there.</p><a class="button primary" href="/docs/quickstart/">Follow the quick start <span aria-hidden="true">↗</span></a></div><div class="doc-hub">{groups.map(group => <section class="doc-group"><h2>{group.title}</h2><p>{group.detail}</p><ul>{group.links.map(([title, href]) => <li><a href={href}>{title}</a></li>)}</ul></section>)}</div></div>
</Site>
