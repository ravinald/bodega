---
import { labels, verdictClass, coverageNumber, type PackageEvidence } from '../coverage';
interface Props { pkg: PackageEvidence; expanded?: boolean; }
const { pkg, expanded = false } = Astro.props;
const label = labels[pkg.id] || [pkg.id, pkg.id];
---
<details class="package-row" data-manager={pkg.id} data-verdict={pkg.verdict} open={expanded}>
  <summary><span class="package-name"><strong>{label[0]}</strong><small>{label[1]}</small></span><span class:list={['badge', verdictClass(pkg.verdict)]}>{pkg.verdict}</span><span class="feature-score"><span>{pkg.coverage}</span><span class="score-track" aria-hidden="true"><i style={`width:${coverageNumber(pkg.coverage)}%`}></i></span></span></summary>
  <div class="package-detail"><p>{pkg.reason}</p><h3>Feature support</h3><div class="feature-grid">{pkg.features.map(feature => <details class="feature-entry"><summary><span>{feature.label}</span><strong class={`feature-${feature.value.replace(/[^a-z]/gi, '')}`}>{feature.value}</strong></summary><p>{feature.description}</p><p>{feature.evidence || 'No additional evidence recorded.'}</p></details>)}</div>
    <h3>Real-client test evidence</h3><div class="test-runs">{pkg.runs.length ? pkg.runs.map(run => <details class:list={['test-run', run.class]}><summary>{run.text}{run.class.includes('stale-run') ? ' · stale evidence' : ''}</summary><p>{run.title}</p></details>) : <p>No primary suite results recorded. This is not a passing test result.</p>}</div>
  </div>
</details>
