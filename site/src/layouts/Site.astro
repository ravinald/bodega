---
import '../styles/site.css';
interface Props { title: string; description?: string; }
const { title, description = 'A self-hosted package repository for the hosts you run. Native clients, explicit policy, and evidence you can inspect.' } = Astro.props;
const active = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(active, Astro.site)} />
    <link rel="icon" href="/assets/favicon.ico" sizes="any" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('/assets/depot.png', Astro.site)} />
    <meta name="theme-color" content="#194ee6" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header shell">
      <a class="wordmark" href="/" aria-label="Bodega home"><img src="/assets/depot.png" width="48" height="48" alt="" />bodega<span class="wordmark-dot">.</span></a>
      <nav aria-label="Main navigation">
        <a href="/coverage/" aria-current={active === '/coverage/' ? 'page' : undefined}>Package support</a>
        <a href="/docs/">Docs</a>
        <a href="https://github.com/ravinald/bodega" class="github-link">GitHub <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer shell">
      <div><a class="wordmark" href="/">bodega<span class="wordmark-dot">.</span></a><p>For the hosts you run.</p></div>
      <div class="footer-links"><a href="/docs/quickstart/">Get started</a><a href="/docs/threat-model/">Threat model</a><a href="/docs/security/">Security</a><a href="https://github.com/ravinald/bodega/releases">Releases</a><a href="https://github.com/ravinald/bodega/blob/main/LICENSE">Apache 2.0</a></div>
      <p class="footer-note">Open source. Self-hosted. Pre-1.0.</p>
    </footer>
  </body>
</html>
