# Copy to test/e2e/hosts.env, which is not committed.
#
# The four hosts are scratch guests the suites may destroy: they run
# `bodega reset`, `pkg delete --remove-artifacts` and `userdel bodega`.
# Never name a host you care about.
#
# Two pairs, because the two operating systems fail in different places. The
# Linux pair carries apt, pip, npm and the rest. The FreeBSD pair carries pkg
# and the ports tree: E2E_FREEBSD_HOST is its client, the guest the freebsd
# alias names, which answers whether pkg and make accept what bodega serves.
# E2E_FREEBSD_SERVER_HOST is the only place internal/storage's extattr and
# POSIX.1e ACL paths execute.
#
# E2E_ALLOWED_HOSTS is a second, independent declaration of the same four
# names. run.sh checks the resolved host map against it, so a typo in either
# line stops the run instead of reaching whatever that typo resolves to.

E2E_SERVER_HOST="bodega-server.example.com"
E2E_CLIENT_HOST="bodega-client.example.com"
E2E_FREEBSD_HOST="freebsd-client.example.com"
E2E_FREEBSD_SERVER_HOST="freebsd-server.example.com"
E2E_ALLOWED_HOSTS="bodega-server.example.com bodega-client.example.com freebsd-client.example.com freebsd-server.example.com"
